# .dockerignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
ENV/
env/

# UV
.uv/

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# Tests
tests/
test_*.py
*_test.py

# Documentation
README.md
docs/

# CI/CD
.github/
.gitlab-ci.yml

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Don't ignore .env.azure (we need it in the image)
!.env.azure